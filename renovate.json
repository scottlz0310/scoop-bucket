{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>scottlz0310/renovate-config//presets/default"
  ],
  "customManagers": [
    {
      "description": "setup-scoop が SHA 固定で取得する Scoop 本体（checkout の repository / ref）を追従する。バケット固有のため共有プリセットにはしない",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/actions/setup-scoop/action\\.yml$/"],
      "matchStrings": [
        "repository: (?<depName>ScoopInstaller/Scoop)\\s+ref: (?<currentDigest>[a-f0-9]{40}) # (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-tags"
    }
  ]
}
